AI_PROVIDER=local
# Path is relative to bilanet/backend, where the server is started.
# On a 4-6 GB RAM laptop use qwen2.5-coder-1.5b-instruct-q4_k_m.gguf instead.
MODEL_PATH=../models/qwen2.5-coder-3b-instruct-q4_k_m.gguf
# Or leave MODEL_PATH out and let the app pick and download a model into this folder:
# MODELS_DIR=../models
CONTEXT_SIZE=4096
# auto = number of physical CPU cores
THREADS=auto
MAX_TOKENS=1024
# Free the model's RAM after this many idle seconds (0 = keep it loaded)
IDLE_UNLOAD_SECONDS=300
# Lower = more predictable answers; repeat penalty stops the model looping
TEMPERATURE=0.2
REPEAT_PENALTY=1.15
