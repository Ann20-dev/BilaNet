{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BilaNet",
  "version": "0.1.3",
  "identifier": "com.bilanet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Offline AI coding assistant",
    "longDescription": "BilaNet is an AI coding assistant that runs fully offline on everyday laptops.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/bilanet-backend/": "backend/"
    },
    "macOS": { "signingIdentity": "-" }
  }
}
